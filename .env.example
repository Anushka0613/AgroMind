# Copy this file to .env and fill in your real key.
# Get a Gemini API key from Google AI Studio: https://aistudio.google.com/
#
# If GEMINI_API_KEY is left unset, AgroMind still works fully -- the AI
# Explanation feature falls back to a clear, deterministic template
# explanation instead of a real Gemini-generated one.

GEMINI_API_KEY=your_api_key_here
